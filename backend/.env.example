# ===== Servidor =====
NODE_ENV=production
PORT=3001
PUBLIC_ORIGIN=https://helpdesk.tudominio.com
CORS_ORIGIN=https://helpdesk.tudominio.com

# ===== PostgreSQL =====
DATABASE_URL=postgres://helpdesk_app:CAMBIA_ESTA_PASSWORD@127.0.0.1:5432/helpdesk
PG_POOL_MAX=20

# ===== JWT (cookie HttpOnly) =====
JWT_SECRET=CAMBIA_ESTE_SECRETO_MINIMO_64_CHARS_ALEATORIOS
JWT_EXPIRES_IN=8h
COOKIE_NAME=hd_session
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# ===== Uploads / Nginx X-Accel-Redirect =====
UPLOADS_DIR=/opt/helpdesk/uploads
UPLOADS_MAX_BYTES=20971520
# Ruta interna que Nginx mapea con `internal;` a UPLOADS_DIR
NGINX_INTERNAL_PREFIX=/_protected_uploads

# ===== Bootstrap supervisor (sólo para seed.sql) =====
SEED_SUPERVISOR_USER=supervisor
SEED_SUPERVISOR_EMAIL=admin@helpdesk.local
# Generar hash bcrypt: node -e "console.log(require('bcryptjs').hashSync('CAMBIA_ESTA_PASSWORD',12))"
SEED_SUPERVISOR_PASSWORD_HASH=$2a$12$REEMPLAZAR_CON_HASH_BCRYPT_VALIDO
