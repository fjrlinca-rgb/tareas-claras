# --- Servidor ---
PORT=3001
NODE_ENV=production
CORS_ORIGIN=http://localhost:8080,https://helpdesk.example.com

# --- PostgreSQL ---
DATABASE_URL=postgres://helpdesk:helpdesk@127.0.0.1:5432/helpdesk
PG_POOL_MAX=20

# --- JWT / cookies ---
JWT_SECRET=cambia-esto-por-un-secreto-largo-aleatorio
JWT_EXPIRES=12h
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# --- Uploads ---
UPLOADS_DIR=/opt/helpdesk/uploads
UPLOADS_MAX_BYTES=20971520
NGINX_INTERNAL_PREFIX=/_protected_uploads
